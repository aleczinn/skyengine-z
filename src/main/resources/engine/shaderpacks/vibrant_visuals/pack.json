    {"key":"water_edge_highlight","label":"options.shaderpacks.water_edge_highlight","uniform":"u_WaterEdgeHighlight","type":"boolean","defaultValue":1,"min":0,"max":1,"step":1},
    {"key":"water_edge_highlight_intensity","label":"options.shaderpacks.water_edge_highlight_intensity","uniform":"u_WaterEdgeHighlightIntensity","defaultValue":1,"min":0,"max":2,"step":0.05},
