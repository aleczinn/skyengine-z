{
  "schema": 2,
  "id": "vibrant_visuals",
  "name": "Vibrant Visuals",
  "programs": {
    "terrain_vertex": "shaders/terrain.vert",
    "terrain_fragment": "shaders/terrain.frag",
    "water_shadow_vertex": "shaders/water_shadow.vert",
    "water_shadow_fragment": "shaders/water_shadow.frag",
    "sky_vertex": "shaders/sky.vert",
    "sky_fragment": "shaders/sky.frag",
    "sky_sh_compute": "shaders/sky_sh.comp",
    "air_vl": "shaders/air_vl.frag",
    "water_vl": "shaders/water_vl.frag",
    "fluid_fog": "shaders/fluid_fog.frag",
    "bloom_downsample": "shaders/bloom_downsample.frag",
    "bloom_blur": "shaders/bloom_blur.frag",
    "bloom_upsample": "shaders/bloom_upsample.frag",
    "bloom_composite": "shaders/bloom_composite.frag",
    "color_grading": "shaders/color_grading.frag"
  },
  "textures": {
    "atmosphere_scattering": "textures/scattering.dat",
    "moon_noise": "textures/noise.png"
  },
  "resources": {
    "water_fog_transmittance": {"format":"rgb16f","scale":0.5,"filter":"linear"},
    "water_fog_scattering": {"format":"rgb16f","scale":0.5,"filter":"linear"},
    "shadow_depth_all": {"format":"depth32f","width":2048,"height":2048,"filter":"nearest","persistent":true},
    "shadow_depth_solid": {"format":"depth32f","width":2048,"height":2048,"filter":"nearest","persistent":true},
    "shadow_color": {"format":"rgba8","width":2048,"height":2048,"filter":"linear","persistent":true}
  },
  "passes": [
    {"id":"photon_shadow_solid","type":"geometry","hook":"shadow","vertexProgram":"water_shadow_vertex","program":"water_shadow_fragment","geometry":"terrain_opaque","outputs":["shadow_depth_all","shadow_depth_solid","shadow_color"]},
    {"id":"photon_water_vl","type":"fullscreen","hook":"pre_taa","program":"water_vl","inputs":{"depth_front":"scene_depth","depth_back":"world_depth","shadow_all":"shadow_depth_all","shadow_solid":"shadow_depth_solid","shadow_color":"shadow_color"},"outputs":["water_fog_transmittance","water_fog_scattering"],"condition":"camera_in_water"},
    {"id":"photon_water_composite","type":"fullscreen","hook":"pre_taa","program":"fluid_fog","inputs":{"scene":"scene_color","transmittance":"water_fog_transmittance","scattering":"water_fog_scattering"},"outputs":[],"condition":"camera_in_water"}
  ],
  "settings": [
