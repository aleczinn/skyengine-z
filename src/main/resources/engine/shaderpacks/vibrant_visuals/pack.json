    {"key":"underwater_absorption_r","label":"options.shaderpacks.underwater_absorption_r","uniform":"u_UnderwaterAbsorptionR","defaultValue":0.20,"min":0,"max":1,"step":0.01},
    {"key":"underwater_absorption_g","label":"options.shaderpacks.underwater_absorption_g","uniform":"u_UnderwaterAbsorptionG","defaultValue":0.08,"min":0,"max":1,"step":0.01},
    {"key":"underwater_absorption_b","label":"options.shaderpacks.underwater_absorption_b","uniform":"u_UnderwaterAbsorptionB","defaultValue":0.04,"min":0,"max":1,"step":0.01},
    {"key":"underwater_scattering","label":"options.shaderpacks.underwater_scattering","uniform":"u_UnderwaterScattering","defaultValue":0.03,"min":0,"max":0.10,"step":0.005},
    {"key":"water_light_shafts","label":"options.shaderpacks.water_light_shafts","uniform":"u_WaterLightShafts","type":"boolean","defaultValue":1,"min":0,"max":1,"step":1}
