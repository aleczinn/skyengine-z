    {"key":"shadow_pcf_steps_min","label":"Minimum shadow filter steps","group":"shadows","uniform":"u_ShadowPcfStepsMin","type":"choice","defaultValue":6,"min":4,"max":32,"step":1,"values":[4,6,8,12,16,18,20,22,24,26,28,30,32],"options":["4","6","8","12","16","18","20","22","24","26","28","30","32"]},
    {"key":"shadow_pcf_steps_max","label":"Maximum shadow filter steps","group":"shadows","uniform":"u_ShadowPcfStepsMax","type":"choice","defaultValue":12,"min":4,"max":32,"step":1,"values":[4,6,8,12,16,18,20,22,24,26,28,30,32],"options":["4","6","8","12","16","18","20","22","24","26","28","30","32"]},
    {"key":"shadow_pcf_steps_scale","label":"Adaptive shadow filter steps","group":"shadows","uniform":"u_ShadowPcfStepsScale","defaultValue":1.0,"min":0.0,"max":2.0,"step":0.2},
